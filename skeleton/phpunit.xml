<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Arch">
            <file>tests/ArchTest.php</file>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <testsuite name="Performance">
            <directory>tests/Performance</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>modules</directory>
            <directory>vendor/yuanmaharsyah/admin-core/modules</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Need the built assets: composer check runs them after npm run build (test:built). -->
            <group>vite</group>
            <group>browser</group>
            <!-- A real composer create-project of the published skeleton: composer test:release (bin/release runs it). -->
            <group>release</group>
            <!-- Seeds a million rows: run before a phase review and in the release rehearsal (composer test:perf). -->
            <group>perf</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Production's time zone, so day boundaries are tested as they run. -->
        <env name="APP_TIMEZONE" value="Asia/Jakarta"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="admin_boilerplate_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
