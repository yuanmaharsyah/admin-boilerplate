    public function data(Authenticatable $user, DashboardRange $range): BarChartWidgetData
    {
        /** @var array<string, int> $counts */
        $counts = {{ Model }}::query()->visibleTo($user)
            ->whereBetween('created_at', [$range->from, $range->to])
            ->groupByRaw('DATE(created_at)')
            ->selectRaw('DATE(created_at) as day, count(*) as total')
            ->pluck('total', 'day')
            ->map(fn (mixed $total): int => (int) $total)
            ->all();
        $bars = [];

        for ($day = $range->from; $day <= $range->to; $day = $day->addDay()) {
            $bars[] = new WidgetFigureData(key: $day->toDateString(), label: $day->toDateString(), value: $counts[$day->toDateString()] ?? 0);
        }

        return new BarChartWidgetData(bars: $bars, unit: __('{{ unit }}'));
    }
