import { FormFooter } from '@admin-core/components/admin/FormFooter';
import { PageHeader } from '@admin-core/components/admin/PageHeader';
import { StaleUpdateDialog } from '@admin-core/components/admin/StaleUpdateDialog';
import { UnsavedChangesGuard } from '@admin-core/components/admin/UnsavedChangesGuard';
import { useAdminForm } from '@admin-core/hooks/useAdminForm';
import { useT } from '@admin-core/lib/i18n';
import { Head } from '@inertiajs/react';
import { show, update } from '@/routes/{{ slug }}';
import { {{ Name }}Form } from '../components/{{ Name }}Form';
import type { {{ Name }}FormValues } from '../components/{{ Name }}Form';

type Props = {
    {{ variable }}: Modules.{{ Name }}.Data.{{ Name }}Data;
{{ props }}
};

/** Editing a {{ lower_label }} (generated from the approved pattern-form). */
export default function Edit({ {{ variable }}, {{ destructure }} }: Props) {
    const t = useT();
    const { form, submit, stale, dirtyData, reload } = useAdminForm<
        {{ Name }}FormValues & { lock_version: number }
    >({
{{ initial }}
        lock_version: {{ variable }}.lock_version,
    });
    const title = t('{{ slug }}.edit_title', { name: {{ title }} });

    return (
        <>
            <Head title={title} />
            <form
                noValidate
                className="flex flex-col gap-5"
                onSubmit={(event) => {
                    event.preventDefault();
                    // POST + _method=PUT, so picked files travel with the form.
                    submit({ url: update.form({{ variable }}.id).action, method: 'post' });
                }}
            >
                <PageHeader title={title} backHref={show({{ variable }}.id)} />
                <{{ Name }}Form form={form} record={ {{ variable }} } {{ form_props }} />
                <FormFooter cancelHref={show({{ variable }}.id)} processing={form.processing} dirty={form.isDirty} />
            </form>
            <UnsavedChangesGuard when={form.isDirty && !form.processing && !stale} />
            <StaleUpdateDialog open={stale} dirtyData={dirtyData} onReload={reload} />
        </>
    );
}
