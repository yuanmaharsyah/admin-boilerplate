{
    "name": "yuanmaharsyah/admin-core",
    "description": "Laravel 13 admin core: modules, level-based RBAC, a tamper-resistant audit log, a module generator and the Inertia + React UI.",
    "keywords": [
        "laravel",
        "admin",
        "admin-panel",
        "boilerplate",
        "inertia",
        "react",
        "rbac",
        "audit-log",
        "laravel-data"
    ],
    "homepage": "https://github.com/yuanmaharsyah/admin-boilerplate",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuan Maharsyah",
            "homepage": "https://github.com/yuanmaharsyah"
        }
    ],
    "support": {
        "issues": "https://github.com/yuanmaharsyah/admin-boilerplate/issues",
        "source": "https://github.com/yuanmaharsyah/admin-boilerplate",
        "security": "https://github.com/yuanmaharsyah/admin-boilerplate/security/policy"
    },
    "require": {
        "php": "^8.4",
        "composer/semver": "^3.4",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "maatwebsite/excel": "^4.0.4",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3.6",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Yuan\\AdminCore\\": "src/",
            "Yuan\\AdminCore\\Database\\Seeders\\": "database/seeders/",
            "Yuan\\AdminCore\\Modules\\": "modules/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Yuan\\AdminCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Yuan\\AdminCore\\AdminCoreServiceProvider"
            ]
        }
    }
}
