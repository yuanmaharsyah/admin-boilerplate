import type { {{ Name }}FormValues } from '../components/{{ Name }}Form';

{{ props_type }}/** A new {{ lower_label }} (generated from the approved pattern-form). */
export default function Create({{ signature }}) {
    const t = useT();
    const { form, submit } = useAdminForm<{{ Name }}FormValues>({
{{ initial }}
    });

    return (
