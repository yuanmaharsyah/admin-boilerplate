<?php

declare(strict_types=1);

use Illuminate\Foundation\Testing\RefreshDatabase;
use Modules\{{ Module }}\Models\{{ Model }};
use Modules\{{ Module }}\Widgets\{{ Class }};
use Yuan\AdminCore\Testing\ModuleAssertions;

// The {{ Class }} widget on Beranda (generated by make:widget): permission, scope, time budget.

uses(RefreshDatabase::class);

it('is missing from Beranda without {{ permission }}', function (): void {
    ModuleAssertions::assertWidgetHiddenWithout({{ Class }}::class);
});

it('reads only the records the user may see', function (): void {
    ModuleAssertions::actingAsLevelWith(['dashboard.view', '{{ permission }}']);

    ModuleAssertions::assertWidgetUsesScope({{ Class }}::class, {{ Model }}::class);
});

it('stays within the widget time budget', function (): void {
    {{ Model }}::factory()->count(200)->create();
    ModuleAssertions::actingAsLevelWith(['dashboard.view', '{{ permission }}']);

    ModuleAssertions::assertWidgetWithinBudget({{ Class }}::class);
});
