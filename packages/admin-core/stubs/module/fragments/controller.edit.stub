    public function edit(Request $request, int ${{ variable }}): Response
    {
        $model = {{ Name }}::query()->visibleTo($request->user()){{ with }}->findOrFail(${{ variable }});
        Gate::authorize('update', $model);

        return Inertia::render('{{ Name }}::Edit', [
            '{{ variable }}' => {{ Name }}Data::fromModel($model),
{{ form_props_model }}            'breadcrumbs' => self::breadcrumbs(
                new BreadcrumbData(label: $model->auditLabel(), href: route('{{ slug }}.show', $model)),
                new BreadcrumbData(label: __('Edit'), href: null),
            ),
        ]);
    }

